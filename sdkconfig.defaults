CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O flash: the program runs from flash through a 16 KB cache, and LVGL's code is large; twice the bits per
# clock on cache misses (~30 % faster LVGL rendering than DIO in weather_amoled). The bootloader switches the flash
# to QIO itself (esptool still writes its header as "dio", as ESP-IDF does for QIO): it takes a bootloader built
# with this, i.e. a USB / web-flasher install; an update from a peer keeps the old bootloader.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# No CONFIG_PM_ENABLE: the radio and the 15 ms touch / LVGL loop want the clock (docs/RESEARCH-BLE.md)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 64-byte data cache lines (32 by default, same 32 KB cache): sequential reads from PSRAM fetch twice the bytes per line
# fill. MeteoBus: every PSRAM-bound frame got faster, none slower (zoom fill -5 %, bus map 1725 -> 1663 ms, snapshots ~4 %).
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
# Main task: start-up and the app's loop. Check "main" in the diag tasks line after adding work to it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LV_DEF_REFR_PERIOD=15
# A pager drag after 28 px (espforge's default 10: a tap or a hold with a slight finger move became a swipe, v0.2.0)
CONFIG_FORGE_SLIDE_DRAG_PX=28
# No theme style transitions (80 ms fades on press): each one redraws, and a redraw that changes nothing still costs
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=0
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# A peer's firmware boots pending-verify and confirms itself after 60 s, else the bootloader rolls back (mesh_fw.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# A crash is kept in the coredump partition and summarised at the next boot (diag.c): crash details used to exist
# only if someone was watching the USB log at the time
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Bluetooth LE with the NimBLE host (docs/RESEARCH-BLE.md, "Memory and Kconfig"): advertising flood for state, one
# GATT link on demand for a firmware pull. Wi-Fi is linked (forge_net) but never started.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# Controller activities: 2 adv sets + scan + 2 links + 1 periodic sync = 6 (828 B each)
CONFIG_BT_CTRL_BLE_MAX_ACT=8
# Extended advertising (mesh.c): the flood is instance 0 with legacy PDUs (same packets on air), instance 1 carries a
# voice clip as a periodic train (clip.c); a receiver syncs to it, no link
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=251
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=y
CONFIG_BT_NIMBLE_PERIODIC_ADV_SYNC_TRANSFER=n
CONFIG_BT_NIMBLE_EXT_SCAN=y
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=y
CONFIG_BT_NIMBLE_MAX_PERIODIC_SYNCS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_HS_PVCY=n
# Off: with it on, the host passes each address ONCE per ~200 reports (ble_hs_hci_evt.c ble_check_adv_list), so a
# peer advertising 50 times a second was heard every 2.7 s (step 2b, 2026-10-31). The controller's report flow control
# (ADV_REPORT_FLOW_CTRL_NUM) is the memory guard instead.
CONFIG_BT_NIMBLE_HOST_QUEUE_CONG_CHECK=n
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=200
CONFIG_BT_CTRL_SCAN_DUPL_TYPE_DATA_DEVICE=y
# Off: esp-idf issue 15258 (the scan is cancelled around ble_gap_connect instead)
CONFIG_BT_NIMBLE_HOST_ALLOW_CONNECT_WITH_SCAN=n
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=n
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=50
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=20
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
# Host pools in internal RAM first; EXTERNAL (PSRAM) only if internal RAM runs short (then re-measure the transfer)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Controller and host on core 0: LVGL runs on core 1
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
# Shorter flash write bursts (OTA writes during a firmware pull): less time with the cache off
CONFIG_SPI_FLASH_WRITE_CHUNK_SIZE=4096
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
